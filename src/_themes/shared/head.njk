<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set isPods = section == "pods" %}
<title>{% if title and page.url != "/" %}{{ title }} – {% endif %}{{ site.pods.title if isPods else site.title }}</title>
<meta name="description" content="{{ (site.pods.description if isPods else site.description) | escape }}">
<link rel="canonical" href="https://sigmod.org{{ redirect_to or page.url }}">
<link rel="alternate" type="application/atom+xml" title="SIGMOD news" href="/feed.xml">
<link rel="stylesheet" href="/assets/{{ theme }}.css">
<link rel="stylesheet" href="/assets/footer.css">
<link rel="stylesheet" href="/assets/content.css">
<link rel="icon" href="/assets/logo/sigmod-ribbon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400&display=swap">
