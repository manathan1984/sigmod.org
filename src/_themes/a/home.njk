---
layout: a/base.njk
---
{%- set next = conferences | first -%}
<div class="wrap">
  <section class="intro">
    <p>{{ site.description }} Our members include software developers, academic and industrial researchers, practitioners, users, and students. SIGMOD sponsors the annual <a href="/conferences/">SIGMOD/PODS conference</a>, one of the most important and selective in the field.</p>
  </section>
  <div class="home-grid">
    <section>
      <h2 class="section-title">News</h2>
      {% set newsLimit = 10 %}{% include "shared/news-list.njk" %}
      <p><a href="/news/">All news →</a></p>
    </section>
    <aside class="home-side">
      <div class="box box-conf">
        <h2>Next conference</h2>
        <p class="conf-name">{{ next.name }}</p>
        <p>{{ next.location }}</p>
        <p>{% for l in next.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %} · <a href="/conferences/">Past conferences</a></p>
      </div>
      <div class="box">
        <h2>Popular</h2>
        <ul class="plain">{% for l in nav.quicklinks %}<li><a href="{{ l.url }}">{{ l.label }}</a></li>{% endfor %}</ul>
      </div>
      <div class="box box-pods">
        <h2>PODS</h2>
        <p>{{ site.pods.description }}</p>
        <p><a href="/pods-home/">Visit the PODS pages →</a></p>
      </div>
    </aside>
  </div>
</div>
