---
layout: a/base.njk
---
{%- set menu = nav.main | findMenu(page.url, area) -%}
<div class="wrap page-grid">
  <article class="prose">
    <p class="crumbs"><a href="/">SIGMOD</a>{% if menu and menu.url != page.url %} › <a href="{{ menu.url }}">{{ menu.label }}</a>{% endif %}</p>
    <h1>{{ title }}</h1>
    {{ content | safe }}
    {% include "shared/meta.njk" %}
  </article>
  {%- if menu %}
  <aside class="side">
    <h2>{{ menu.label }}</h2>
    <ul>
      {%- for c in menu.children %}<li><a href="{{ c.url }}"{% if c.url == page.url %} aria-current="page"{% endif %}>{{ c.label }}</a></li>{% endfor %}
    </ul>
  </aside>
  {%- endif %}
</div>
