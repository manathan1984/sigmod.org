---
layout: b/base.njk
---
{%- set menu = nav.main | findMenu(page.url, area) -%}
<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/">SIGMOD</a>{% if menu %} <span>/</span> <a href="{{ menu.url }}">{{ menu.label }}</a>{% endif %}{% if wp_type == "post" %} <span>/</span> <a href="/news/">News</a>{% endif %}</p>
    <h1>{{ title }}</h1>
    {%- if wp_type == "post" %}<p class="hero-date">{{ date | date }}</p>{% endif %}
  </div>
</section>
<div class="wrap page-grid{% if not menu %} no-side{% endif %}">
  {%- if menu %}
  <aside class="side">
    <nav aria-label="{{ menu.label }}">
      <ul>{% for c in menu.children %}<li><a href="{{ c.url }}"{% if c.url == page.url %} aria-current="page"{% endif %}>{{ c.label }}</a></li>{% endfor %}</ul>
    </nav>
  </aside>
  {%- endif %}
  <article class="prose">
    {{ content | safe }}
    {% include "shared/meta.njk" %}
  </article>
</div>
